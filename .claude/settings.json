{
    "permissions": {
        "allow": [
            "Read",
            "Edit",
            "Write",
            "Glob",
            "Grep",
            "Bash(git status)",
            "Bash(git diff)",
            "Bash(git diff --check)",
            "Bash(git log -5 --oneline)",
            "Bash(npm run ng -- *)",
            "Bash(npm run start -- *)",
            "Bash(npm run build -- *)",
            "Bash(npm run watch -- *)",
            "Bash(npm test -- *)",
            "Bash(npm run test -- *)",
            "Bash(npm run lint -- *)"
        ],
        "deny": [
            "Read(./node_modules/**)",
            "Read(./dist/**)",
            "Read(./coverage/**)",
            "Read(./.git/**)",
            "Read(./logs/**)",
            "Read(./tmp/**)",
            "Read(./generated/**)",
            "Write(./node_modules/**)",
            "Write(./dist/**)",
            "Write(./coverage/**)",
            "Write(./.git/**)",
            "Edit(./node_modules/**)",
            "Edit(./dist/**)",
            "Edit(./.git/**)"
        ]
    }
}